# Résultats d'analyse et bases générées : publiés en releases, jamais versionnés
resultats/
*.db
*.db.gz
*.jsonl
*.jsonl.gz
!tools/sample_*.jsonl

# Python
__pycache__/
*.pyc

# Flutter / Android (à compléter quand l'application sera créée)
.dart_tool/
build/
*.iml
.idea/

# Secrets : ne jamais les déposer dans le dépôt
*.jks
*.keystore
key.properties
.env

# Application Flutter : la base découpée est produite par la CI (tools/build_assets.py)
app/assets/db/part_*
app/assets/db/manifest.json
app/.dart_tool/
app/.flutter-plugins*
app/.packages
app/pubspec.lock
app/android/
app/windows/
app/macos/
app/ios/
app/linux/
app/web/
app/.metadata
app/analyse.txt
app/icones.txt
